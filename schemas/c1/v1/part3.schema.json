{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c1-trainer.local/schemas/c1/v1/part3.schema.json",
  "title": "C1 Advanced Part 3 word formation",
  "type": "object",
  "allOf": [
    { "$ref": "./shared.schema.json#/$defs/BaseExercise" },
    {
      "type": "object",
      "required": ["part", "type", "content", "questions"],
      "properties": {
        "part": { "const": 3 },
        "type": { "const": "word_formation" },
        "content": { "$ref": "./shared.schema.json#/$defs/ClozeText" },
        "questions": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/Question" }
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "Question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "gap", "root", "canonicalAnswer", "transformations", "explanation"],
      "properties": {
        "id": { "type": "string", "pattern": "^q[1-8]$" },
        "gap": { "type": "integer", "minimum": 1, "maximum": 8 },
        "root": { "type": "string", "minLength": 1 },
        "canonicalAnswer": { "type": "string", "minLength": 1 },
        "acceptedAnswers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "transformations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["prefix", "negative_prefix", "suffix", "compound", "internal_change", "word_class_change"]
          }
        },
        "explanation": { "type": "string", "minLength": 1 }
      }
    }
  }
}
