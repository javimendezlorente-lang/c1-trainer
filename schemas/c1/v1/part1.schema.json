{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c1-trainer.local/schemas/c1/v1/part1.schema.json",
  "title": "C1 Advanced Part 1 multiple-choice cloze",
  "type": "object",
  "allOf": [
    { "$ref": "./shared.schema.json#/$defs/BaseExercise" },
    {
      "type": "object",
      "required": ["part", "type", "content", "questions"],
      "properties": {
        "part": { "const": 1 },
        "type": { "const": "multiple_choice_cloze" },
        "content": { "$ref": "./shared.schema.json#/$defs/ClozeText" },
        "questions": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/Question" }
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "Question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "gap", "options", "correctOptionId", "explanation"],
      "properties": {
        "id": { "type": "string", "pattern": "^q[1-8]$" },
        "gap": { "type": "integer", "minimum": 1, "maximum": 8 },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-D]$" },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        },
        "correctOptionId": { "type": "string", "pattern": "^[A-D]$" },
        "explanation": { "type": "string", "minLength": 1 },
        "distractorExplanations": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
