{
  "name": "c1-trainer",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Independent browser-first study tool for Cambridge C1 Advanced preparation",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/validate-content.mjs",
    "generate:icons": "node scripts/generate-pwa-icons.mjs",
    "verify:pwa": "node scripts/verify-pwa-build.mjs",
    "generate:part1": "node scripts/generate-part1.mjs",
    "factory": "pnpm --dir factory exec tsx src/cli.ts",
    "factory:test": "pnpm --dir factory test",
    "factory:typecheck": "pnpm --dir factory typecheck",
    "content:promote": "pnpm --dir factory exec tsx src/cli.ts promote",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "dexie": "4.4.6",
    "dexie-react-hooks": "^1.1.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0",
    "ts-fsrs": "5.4.2",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "ajv": "8.17.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "6.2.4",
    "globals": "^16.5.0",
    "jsdom": "^25.0.1",
    "typescript": "5.8.3",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^2.1.8"
  }
}
