{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c1-trainer.local/schemas/c1/v1/part2.schema.json",
  "title": "C1 Advanced Part 2 open cloze",
  "type": "object",
  "allOf": [
    { "$ref": "./shared.schema.json#/$defs/BaseExercise" },
    {
      "type": "object",
      "required": ["part", "type", "content", "questions"],
      "properties": {
        "part": { "const": 2 },
        "type": { "const": "open_cloze" },
        "content": { "$ref": "./shared.schema.json#/$defs/ClozeText" },
        "questions": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/Question" }
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "Question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "gap", "acceptedAnswers", "canonicalAnswer", "explanation"],
      "properties": {
        "id": { "type": "string", "pattern": "^q[1-8]$" },
        "gap": { "type": "integer", "minimum": 1, "maximum": 8 },
        "acceptedAnswers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "canonicalAnswer": { "type": "string", "minLength": 1 },
        "explanation": { "type": "string", "minLength": 1 }
      }
    }
  }
}
