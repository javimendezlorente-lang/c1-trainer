{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c1-trainer.local/generation/part1-candidate-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "difficulty", "topic", "skills", "content", "questions"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "difficulty": { "type": "integer", "enum": [3, 4, 5] },
    "topic": { "type": "string", "minLength": 1, "maxLength": 80 },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primarySkill", "secondarySkills"],
      "properties": {
        "primarySkill": { "enum": ["collocation", "fixed_expression", "phrasal_verb", "idiom", "semantic_precision", "complementation"] },
        "secondarySkills": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["collocation", "fixed_expression", "phrasal_verb", "idiom", "semantic_precision", "complementation"] }
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "gaps"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "gaps": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "number"],
            "properties": {
              "id": { "type": "string", "pattern": "^g[1-8]$" },
              "number": { "type": "integer", "minimum": 1, "maximum": 8 }
            }
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "gap", "options", "correctOptionId", "explanation"],
        "properties": {
          "id": { "type": "string", "pattern": "^q[1-8]$" },
          "gap": { "type": "integer", "minimum": 1, "maximum": 8 },
          "options": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "text"],
              "properties": {
                "id": { "enum": ["A", "B", "C", "D"] },
                "text": { "type": "string", "minLength": 1, "maxLength": 60 }
              }
            }
          },
          "correctOptionId": { "enum": ["A", "B", "C", "D"] },
          "explanation": { "type": "string", "minLength": 1, "maxLength": 500 },
          "distractorExplanations": {
            "type": "object",
            "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        }
      }
    }
  }
}
